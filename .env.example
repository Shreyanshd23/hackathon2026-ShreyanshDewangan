# ── LLM providers (leave blank to run fully offline with the mock LLM) ──
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ── Offline mode ──
# 1 = deterministic mock LLM, no API calls (auto-on when GROQ_API_KEY is empty)
OFFLINE_MODE=0

# ── Rate limiting (match your provider tier) ──
LLM_RPM=28
LLM_TPM=11000
MAX_CONCURRENT_TICKETS=8

# ── Resilience / simulation ──
FAILURE_INJECTION_RATE=0.05

# ── Server ──
FLASK_DEBUG=0
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
LOG_LEVEL=INFO
PORT=5000
